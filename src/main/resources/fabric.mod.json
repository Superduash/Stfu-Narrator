{
	"schemaVersion": 1,
	"id": "shutupnarrator",
	"version": "${version}",
	"name": "Stfu Narrator",
	"description": "Skip Minecraft's Accessibility onboarding screen and disable the Narrator hotkey.",
	"authors": [
		"Superduash"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/shutup-narrator",
		"sources": "https://github.com/Superduash/Stfu-Narrator",
		"issues": "https://github.com/Superduash/Stfu-Narrator/issues"
	},
	"license": "MIT",
	"icon": "assets/shutupnarrator/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.superduash.shutupnarrator.ShutUpNarrator"
		]
	},
	"mixins": [
		"shutupnarrator.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
